PORT=3001

# Backend: mantenha a API key do Appwrite e a chave privada do ImageKit somente no servidor.
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=seu_project_id
APPWRITE_API_KEY=sua_api_key_do_appwrite
APPWRITE_DATABASE_ID=seu_database_id
APPWRITE_WORKS_COLLECTION_ID=Obras
APPWRITE_CHAPTERS_COLLECTION_ID=Capitulos
APPWRITE_PAGES_COLLECTION_ID=Paginas
# Opcional: coleções para as rotas de pedidos.
APPWRITE_MODERATION_REQUESTS_COLLECTION_ID=PedidosModeracao
APPWRITE_WORK_REQUESTS_COLLECTION_ID=PedidosObra

IMAGEKIT_PUBLIC_KEY=sua_chave_publica
IMAGEKIT_PRIVATE_KEY=sua_chave_privada
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/seu_id
MAX_IMAGE_BYTES=20971520
MAX_CHAPTER_PAGES=500
MAX_CHAPTER_ARCHIVE_BYTES=104857600

# Frontend: estes identificadores são públicos; não coloque segredos com prefixo VITE_.
VITE_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=seu_project_id

GEMINI_API_KEY=cole_sua_chave_aqui
OPENAI_API_KEY=cole_sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini
QWEN_API_KEY=cole_sua_chave_qwen_aqui
QWEN_MODEL=qwen-vl-max
# QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
GROQ_API_KEY=cole_sua_chave_groq_aqui
GROQ_MODEL=llama-3.2-11b-vision-preview
