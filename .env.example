PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Temporary Appwrite bridge and one-time data import
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_temporary_server_api_key
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_WORKS_COLLECTION_ID=your_works_collection_id
APPWRITE_CHAPTERS_COLLECTION_ID=your_chapters_collection_id
APPWRITE_PAGES_COLLECTION_ID=your_pages_collection_id
APPWRITE_MODERATION_REQUESTS_COLLECTION_ID=your_moderation_requests_collection_id
APPWRITE_WORK_REQUESTS_COLLECTION_ID=your_work_requests_collection_id

# ImageKit (unchanged)
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# SMTP for password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Optional AI providers
GEMINI_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
GROQ_API_KEY=

MAX_IMAGE_BYTES=20971520
MAX_CHAPTER_ARCHIVE_BYTES=104857600
MAX_CHAPTER_PAGES=500
